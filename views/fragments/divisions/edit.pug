include ../mixins/role-select
form(hx-put="/divisions/" + division.id hx-encoding="multipart/form-data" hx-swap="outerHTML")
    label(for="name") Division Name: *
    input#name(type="text" name="name" value=division.name required)
    //- label(for="description") Description:
    //- input#description(type="text" value=division.description name="description")
    //- br
    label(for="open") Open Registration:
    input#open(type="checkbox" checked=division.open name="open")
    //- label(for="min_players") Minimum Players per Team:
    //- input#min_players(type="number" value=division.min_players name="min_players")
    //- br
    //- label(for="max_players") Maximum Players per Team:
    //- input#max_players(type="number" value=division.max_players name="max_players")
    //- br
    label(for="discord") Division Admin Discord ID: *
    input#discord(type="text" value=division.admin.discord name="discord" required disabled)
    +role-select("manager_role", "Manager Role:", roles, division.manager_role)
    +role-select("player_role", "Player Role:", roles, division.player_role)
    input(type="submit" value="Submit")
    input(type="button" value="Cancel" hx-get="/divisions/" + division.id hx-target="closest form" hx-swap="outerHTML")