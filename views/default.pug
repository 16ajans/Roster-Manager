doctype html
html(lang="en")
    head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      title=title
      link(rel='stylesheet' href='/css/default.css')
      meta(name='csrf-token' content=_csrf)
      script(src='/js/htmx.min.js')
      script.
        document.addEventListener('htmx:configRequest', function (evt) {
          evt.detail.headers['X-CSRF-Token'] = document.querySelector('meta[name="csrf-token"]').content
        })
      link(rel='preconnect' href='https://cdn.discordapp.com/')
      link(rel='icon' type='image/x-icon' href='/images/favicon.png')
      meta(property="og:title" content="CVRE Roster Manager")
      meta(property="og:type" content="website")
      meta(property="og:url" content="https://cvre.app/")
      meta(property="og:image" content="https://cvre.app/images/CVRE.png")
      meta(name="theme-color" content="#703893")
    body
      include blocks/header
      main
        block content
      include blocks/footer